{
  "name": "tickstrike-web-base",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:component": "vitest run test/component",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "check:unused": "knip",
    "golden:update": "node dev/tools/update-goldens.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run check:boundaries && npm run test:unit && npm run test:component && npm run build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "gsap": "3.15.0",
    "pixi.js": "8.19.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@swc/core": "^1.15.46",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.15",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "dependency-cruiser": "^18.1.0",
    "jsdom": "^26.1.0",
    "knip": "^6.27.0",
    "oxlint": "1.74.0",
    "prettier": "3.9.5",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12"
  }
}
