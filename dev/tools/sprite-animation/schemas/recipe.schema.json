{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "frames_per_direction",
    "source_pose_sequence",
    "frame_durations_ms",
    "anchor",
    "overflow_policy",
    "effect_coordinate_space",
    "end_state",
    "recipe_status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "frames_per_direction": { "const": 8 },
    "source_pose_sequence": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 3 },
      "minItems": 8,
      "maxItems": 8
    },
    "frame_durations_ms": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "minItems": 8,
      "maxItems": 8
    },
    "overflow_policy": { "const": "clip" },
    "effect_coordinate_space": { "enum": ["actor", "screen", "attack"] },
    "end_state": { "enum": ["persistent", "despawn", "empty", "corpse", "transition"] },
    "recipe_status": { "enum": ["draft", "approved"] }
  }
}
